# Hold'em server settings. Copy this file to "server.properties" on the host machine and edit it.
# server.properties is not committed, because it holds the database password.

# PostgreSQL on the host machine. These values match docker-compose.yml.
db.url=jdbc:postgresql://localhost:5433/holdem
db.user=holdem
db.password=holdem

# Ports. Other PCs must be allowed through the firewall on both.
# http.port is informational: Tomcat's port is set in poker-server/pom.xml (cargo.servlet.port).
http.port=8080
discovery.port=8888
