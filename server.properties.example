# Hold'em server settings. Copy this file to "server.properties" on the host machine and edit it.
# server.properties is not committed, because it holds the database password.
# Every setting is optional: the values below are the defaults, and they match docker-compose.yml.

# PostgreSQL on the host machine.
db.url=jdbc:postgresql://localhost:5433/holdem
db.user=holdem
db.password=holdem
# The most database connections kept open at once.
db.pool.size=5

# Ports. Other PCs must be allowed through the firewall on both.
# The game's port is chosen on the start command, with -Dholdem.port=9090 say, and the server
# then knows it. http.port matters only if the server is started some other way: it is the port
# players are told to connect to.
http.port=8080
discovery.port=8888

# How many days a login lasts before the player has to log in again.
token.days=7

# Waits in a room. 0 means "at once".
# Pause between the end of one hand and the start of the next, in milliseconds.
hand.delay.ms=3000
# Pause before each card when the board is dealt with everyone all-in, in milliseconds.
runout.pause.ms=1000
# How long a disconnected player keeps their turn timer before being sat out, in seconds.
reconnect.grace.seconds=60
# A room with nobody connected for this many minutes closes.
room.idle.minutes=30

# Computer players pause this long before acting, so a person can follow the game: a random time
# between the two, in milliseconds. 0 and 0 makes them act at once.
bot.think.min.ms=800
bot.think.max.ms=2500

# Expert bot: plays a strategy trained by the trainer (trainer/README.md), heads-up, and solves the
# river card by card. Give the two files the trainer wrote, as absolute paths; without them the
# server offers Easy, Medium and Hard only. They take about 300 MB of memory.
#   cd trainer && cargo run --release -- abstraction --out runs/abstraction-h200.bin --buckets 200
#   cargo run --release -- holdem --abstraction runs/abstraction-h200.bin --iterations 60000000 \
#       --table-bits 23 --save runs/bp.bin
#blueprint.abstraction=/path/to/holdem/trainer/runs/abstraction-h200.bin
#blueprint.strategy=/path/to/holdem/trainer/runs/bp.bin
# Iterations of river re-solving per hand; 0 plays the trained river instead (faster, weaker).
#blueprint.resolve.iterations=200
